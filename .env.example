PORT=3000
LOG_LEVEL=debug
# Host port Docker binds MySQL to (docker-compose). Override if 3306 is taken;
# keep it in sync with DB_PORT below.
MYSQL_PORT=3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASS=app
DB_NAME=app
# RSA keypair (PEM). Generate with: deno task keys:gen
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=http://localhost:3000
# Retired signing public keys still honored during rotation (JSON array of PEM strings)
JWT_PREVIOUS_PUBLIC_KEYS=[]
# Optional bootstrap admin seeded by `deno task db:seed`
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# SSO session lifetime (seconds); auth-code lifetime (seconds)
SSO_SESSION_TTL=2592000
AUTH_CODE_TTL=60
# Email verification link lifetime (seconds)
EMAIL_VERIFICATION_TTL=86400
# Set true ONLY for local development (logs the verification link, which carries
# a live token, and the recipient address in plaintext)
EMAIL_LOG_LINKS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Number of reverse proxies in front of this service; 0 ignores X-Forwarded-For.
# Must be the EXACT hop count (e.g. 2 behind Cloudflare -> nginx): the client IP
# is read that many entries from the right of X-Forwarded-For. Legacy true/false
# still parse as 1/0, but `true` warns at startup.
TRUST_PROXY=0
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379   # host port Docker binds Redis to (compose --profile redis)
